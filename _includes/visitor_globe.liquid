<section class="visitor-globe-section" aria-label="visitor map">
  <div class="visitor-globe-frame">
    {% if site.visitor_globe_embed %}
      <div class="visitor-globe-embed">
        {{ site.visitor_globe_embed }}
      </div>
    {% else %}
      <canvas class="visitor-globe-canvas" width="180" height="180" aria-label="rotating visitor map globe"></canvas>
      <script defer src="{{ '/assets/js/visitor-globe.js' | relative_url | bust_file_cache }}"></script>
    {% endif %}
  </div>
</section>
