<section class="visitor-globe-section" aria-label="visitor map">
  <h2>visitor map</h2>
  <div class="visitor-globe-frame">
    {% if site.visitor_globe_embed %}
      {{ site.visitor_globe_embed }}
    {% else %}
      <div class="visitor-globe-fallback" aria-hidden="true">
        <div class="visitor-globe-orbit"></div>
        <div class="visitor-globe-sphere">
          <span class="visitor-globe-pin pin-1"></span>
          <span class="visitor-globe-pin pin-2"></span>
          <span class="visitor-globe-pin pin-3"></span>
          <span class="visitor-globe-pin pin-4"></span>
        </div>
      </div>
    {% endif %}
  </div>
</section>
